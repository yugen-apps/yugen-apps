<UserControl x:Class="Yugen.Apps.WinUi.Views.Main.ProjectTileUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Yugen.Apps.WinUi.Views.Main"
             xmlns:localXaml="using:Yugen.Apps.WinUi.Views.Xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <XamlUICommand x:Key="LaunchXamlUICommand"
                       Command="{x:Bind LaunchCommand}" />

        <DataTemplate x:Key="AccentLinkDataTemplate"
                      x:DataType="local:LinkObservableObject">
            <Button Command="{StaticResource LaunchXamlUICommand}"
                    CommandParameter="{x:Bind Href, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ImageIcon Width="20"
                               localXaml:ThemeAwareIcon.IconId="{x:Bind Type, Mode=OneWay}" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0"
                               Text="{x:Bind CommandText, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DefaultLinkDataTemplate"
                      x:DataType="local:LinkObservableObject">
            <Button Command="{StaticResource LaunchXamlUICommand}"
                    CommandParameter="{x:Bind Href, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
                <ImageIcon Width="20"
                           localXaml:ThemeAwareIcon.IconId="{x:Bind Type, Mode=OneWay}" />
            </Button>
        </DataTemplate>

        <localXaml:LinkObservableObjectDataTemplateSelector x:Key="LinkDataTemplateSelector"
                                                            AccentTemplate="{StaticResource AccentLinkDataTemplate}"
                                                            DefaultTemplate="{StaticResource DefaultLinkDataTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="TileRoot"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1"
              AutomationProperties.Name="{x:Bind Project.Title, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,16,4,4"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Text="{x:Bind Project.Title, Mode=OneWay}" />

            <TextBlock Grid.Row="1"
                       Margin="0,0,4,4"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind Project.Caption, Mode=OneWay}"
                       Visibility="{x:Bind Project.HasCaption, Mode=OneWay}" />

            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Margin="0,0,16,16"
                       HorizontalTextAlignment="Left"
                       MaxLines="3"
                       Text="{x:Bind Project.Description, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="WrapWholeWords"
                       ToolTipService.ToolTip="{x:Bind Project.Description, Mode=OneWay}" />

            <Border Grid.RowSpan="3"
                    Grid.Column="1"
                    Width="42"
                    Margin="16,0,16,0"
                    Padding="0,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,12,12"
                    ToolTipService.ToolTip="{x:Bind Project.OrgDisplayName, Mode=OneWay}"
                    Visibility="{x:Bind Project.HasOrg, Mode=OneWay}">
                <ImageIcon Width="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           localXaml:ThemeAwareIcon.IconId="{x:Bind Project.Org, Mode=OneWay}" />
            </Border>
        </Grid>

        <Image x:Name="TileImage"
               MaxWidth="96"
               Margin="16"
               VerticalAlignment="Top"
               Source="{x:Bind Project.ImageSrc, Mode=OneWay}"
               Stretch="Uniform" />

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <ItemsRepeater ItemTemplate="{StaticResource LinkDataTemplateSelector}"
                           ItemsSource="{x:Bind Project.Links, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal"
                                 Spacing="8" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </Border>
    </Grid>
</UserControl>