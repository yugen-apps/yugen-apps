<Window x:Class="Yugen.Apps.WinUi.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:adapters="using:Yugen.Apps.WinUi.Adapters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ic="using:FluentIcons.WinUI"
        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
        xmlns:local="using:Yugen.Apps.WinUi.Views.Main"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rojpectsService="using:Yugen.Apps.Shared.ProjectsService"
        xmlns:behaviors="using:Yugen.Apps.WinUi.Behaviors"
        Title="{x:Bind WindowTitle}"
        mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <interactivity:Interaction.Behaviors>
            <interactivity:EventTriggerBehavior EventName="Loaded">
                <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.LoadCommand}" />
            </interactivity:EventTriggerBehavior>
        </interactivity:Interaction.Behaviors>

        <TitleBar x:Name="AppTitleBar"
                  Title="{x:Bind WindowTitle}"
                  Grid.Row="0"
                  VerticalAlignment="Top">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Store/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid x:Name="TopBanner"
              Grid.Row="1"
              Margin="32,12"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}"
              ColumnSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image Grid.RowSpan="2"
                   Height="72"
                   Source="/Assets/Img/Logo-NoBackground.svg" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Bottom"
                       Style="{StaticResource TitleLargeTextBlockStyle}"
                       Text="YUGEN APPS" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       VerticalAlignment="Top"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Text="A profound awareness of the universe that triggers a deep emotional response." />
        </Grid>

        <Image Grid.RowSpan="2"
               Height="192"
               Margin="24,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Source="{ThemeResource BannerBackgroundImageSource}" />

        <SelectorBar Grid.Row="3"
                     Margin="4,0,4,4"
                     Background="{ThemeResource LayerOnMicaBaseAltFillColorTertiaryBrush}"
                     CornerRadius="8">
            <interactivity:Interaction.Behaviors>
                <behaviors:SelectorBarSelectionChangedBehavior Command="{x:Bind ViewModel.SelectorBarSelectionChangedCommand}"/>
            </interactivity:Interaction.Behaviors>

            <SelectorBarItem Text="Microsoft Store Apps">
                <SelectorBarItem.Icon>
                    <ic:FluentIcon Icon="StoreMicrosoft"
                                   IconVariant="Regular"
                                   IconSize="Size24" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Dev Toolkit">
                <SelectorBarItem.Icon>
                    <ic:FluentIcon Icon="WindowDevTools"
                                   IconVariant="Regular"
                                   IconSize="Size24" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="External">
                <SelectorBarItem.Icon>
                    <ic:FluentIcon Icon="Earth"
                                   IconVariant="Regular"
                                   IconSize="Size24" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <Border Grid.Row="4"
                Margin="4,0,4,4"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorTertiaryBrush}"
                CornerRadius="8">
            <ItemsRepeaterScrollHost>
                <ScrollViewer>
                    <ItemsRepeater Margin="32"
                                   ItemsSource="{x:Bind ViewModel.SelectedCategories, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical"
                                         Spacing="32" />
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:CategoryObservableObject">
                                <Grid HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{x:Bind Title}"
                                      RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                                               Text="{x:Bind Title}" />
                                    <ScrollViewer Grid.Row="1"
                                                  Padding="0,8"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  HorizontalScrollMode="Auto"
                                                  IsHorizontalRailEnabled="True"
                                                  VerticalScrollMode="Disabled">
                                        <ItemsRepeater ItemsSource="{x:Bind Projects, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal"
                                                             Spacing="32" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="local:ProjectObservableObject">
                                                    <local:ProjectTileUserControl Project="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </ItemsRepeaterScrollHost>
        </Border>

        <!--
		<WebView2 x:Name="WebView2"
                    Source="https://www.yugenapps.com/"
                    CoreWebView2Initialized="WebView2_CoreWebView2Initialized" />
        -->
    </Grid>
</Window>