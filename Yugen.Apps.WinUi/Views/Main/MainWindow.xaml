<Window x:Class="Yugen.Apps.WinUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:adapters="using:Yugen.Apps.WinUi.Adapters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ic="using:FluentIcons.WinUI"
        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
        xmlns:local="using:Yugen.Apps.WinUi.Views.Main"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rojpectsService="using:Yugen.Apps.Shared.ProjectsService"
        Title="Yugen.Apps.WinUi"
        mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid ColumnDefinitions="*, 5*, *"
          RowDefinitions="Auto, Auto, *">

        <interactivity:Interaction.Behaviors>
            <interactivity:EventTriggerBehavior EventName="Loaded">
                <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.LoadCommand}" />
            </interactivity:EventTriggerBehavior>
        </interactivity:Interaction.Behaviors>

        <TitleBar x:Name="AppTitleBar"
                  Title="Yugen.Apps.WinUi"
                  Grid.ColumnSpan="3">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Store/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <FlipView Grid.Row="1"
                  Grid.Column="1"
                  Height="200"
                  Margin="0,4"
                  HorizontalAlignment="Center">
            <Image Source="ms-appx:///Assets/Img/Headers/1.png" />
            <Image Source="ms-appx:///Assets/Img/Headers/2.png" />
            <Image Source="ms-appx:///Assets/Img/Headers/3.png" />
            <Image Source="ms-appx:///Assets/Img/Headers/4.png" />
        </FlipView>

        <GridView Grid.Row="2"
                  Grid.Column="1"
                  HorizontalAlignment="Center"
                  ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}">

            <GridView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}"
                       TargetType="GridViewItem">
                    <Setter Property="Margin"
                            Value="4" />
                </Style>
            </GridView.ItemContainerStyle>

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="3"
                                   Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ProjectObservableObject">
                    <Grid Width="280"
                          AutomationProperties.Name="{x:Bind Title}">

                        <Image Source="{x:Bind ImageSrc}"
                               Stretch="UniformToFill" />

                        <StackPanel Height="40"
                                    Padding="4,1"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                                    Opacity=".75"
                                    Orientation="Vertical">
                            <TextBlock Foreground="{ThemeResource SystemControlForegroundAltHighBrush}"
                                       Text="{x:Bind Title}" />
                        </StackPanel>

                        <StackPanel Height="40"
                                    Padding="4,1"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                                    Opacity=".75"
                                    Orientation="Horizontal">
                            <ItemsRepeater ItemsSource="{x:Bind Links}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal"
                                                 Spacing="4" />
                                </ItemsRepeater.Layout>

                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:LinkObservableObject">
                                        <HyperlinkButton Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                                                         BorderThickness="1"
                                                         NavigateUri="{x:Bind Href}"
                                                         ToolTipService.ToolTip="{x:Bind Href}">
                                            <ic:FluentIcon Icon="{x:Bind IconName}"
                                                           IconSize="Size24" />
                                        </HyperlinkButton>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Button Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind adapters:VisibilityAdapters.IsValidString(Description), Mode=OneWay}">
                                <ic:FluentIcon Icon="Info"
                                               IconSize="Size24" />
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel>
                                            <TextBlock Style="{ThemeResource BaseTextBlockStyle}"
                                                       Text="{x:Bind Description}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>

    <!--<Grid Grid.Row="1">
			<WebView2 x:Name="WebView2"
                       Source="https://www.yugenapps.com/"
                       CoreWebView2Initialized="WebView2_CoreWebView2Initialized" />
		</Grid>-->
</Window>