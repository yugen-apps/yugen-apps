<Window x:Class="Yugen.Apps.WinUi.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:adapters="using:Yugen.Apps.WinUi.Adapters"
        xmlns:ctkc="using:CommunityToolkit.WinUI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ic="using:FluentIcons.WinUI"
        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
        xmlns:local="using:Yugen.Apps.WinUi.Views.Main"
        xmlns:localXaml="using:Yugen.Apps.WinUi.Views.Xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rojpectsService="using:Yugen.Apps.Shared.ProjectsService"
        Title="{x:Bind ViewModel.WindowTitle}"
        mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <XamlUICommand x:Key="Launch2XamlUICommand"
                           Command="{x:Bind ViewModel.LaunchCommand}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <interactivity:Interaction.Behaviors>
            <interactivity:EventTriggerBehavior EventName="Loaded">
                <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.LoadCommand}" />
            </interactivity:EventTriggerBehavior>
        </interactivity:Interaction.Behaviors>

        <TitleBar x:Name="AppTitleBar"
                  Title="{x:Bind ViewModel.WindowTitle}"
                  Grid.Row="0"
                  VerticalAlignment="Top">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Store/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid x:Name="TopBanner"
              Grid.Row="1"
              Margin="32,12"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}"
              ColumnSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Image Grid.RowSpan="2"
                   Height="72"
                   Source="/Assets/Img/Logo-NoBackground.svg" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Bottom"
                       Style="{StaticResource TitleLargeTextBlockStyle}"
                       Text="YUGEN APPS" />

            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       VerticalAlignment="Top"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Text="A profound awareness of the universe that triggers a deep emotional response." />
        </Grid>

        <Image Grid.RowSpan="2"
               Height="192"
               Margin="24,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Source="{ThemeResource BannerBackgroundImageSource}" />

        <Grid Grid.Row="4"
              Margin="4,0,4,4"
              Padding="16"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="{x:Bind Title}"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorTertiaryBrush}"
              CornerRadius="8"
              RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <ctkc:Segmented ItemsSource="{x:Bind ViewModel.AllCategories, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                            HorizontalAlignment="Center">
                <ctkc:Segmented.ItemTemplate>
                    <DataTemplate x:DataType="local:CategoryObservableObject">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <ImageIcon Width="20"
                                       localXaml:ThemeAwareIcon.IconId="{x:Bind Type}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Title}" />
                        </Grid>
                    </DataTemplate>
                </ctkc:Segmented.ItemTemplate>
            </ctkc:Segmented>

            <ScrollViewer Grid.Row="1"
                          Padding="0,8">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedCategory.Projects, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinColumnSpacing="16"
                                           MinRowSpacing="16" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:ProjectObservableObject">
                            <local:ProjectTileUserControl Project="{x:Bind}"
                                                          LaunchCommand="{StaticResource Launch2XamlUICommand}" />

                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Popup Grid.Row="1" 
               Grid.RowSpan="4" 
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               IsOpen="{x:Bind ViewModel.IsPopupOpen, Mode=OneWay}">
            <StackPanel BorderThickness="1"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                <WebView2 Height="600"
                          Width="800"
                          Source="{x:Bind ViewModel.WebViewSource, Mode=OneWay}" />

                <Button Content="Close"
                        Command="{x:Bind ViewModel.ClosePopupCommand}" />
            </StackPanel>
        </Popup>

    </Grid>
</Window>