<Window x:Class="Yugen.Apps.WinUi.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:adapters="using:Yugen.Apps.WinUi.Adapters"
        xmlns:ctkc="using:CommunityToolkit.WinUI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ic="using:FluentIcons.WinUI"
        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
        xmlns:local="using:Yugen.Apps.WinUi.Views.Main"
        xmlns:localXaml="using:Yugen.Apps.WinUi.Views.Xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rojpectsService="using:Yugen.Apps.Shared.ProjectsService"
        Title="{x:Bind ViewModel.WindowTitle}"
        mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <XamlUICommand x:Key="MainLaunchXamlUICommand"
                           Command="{x:Bind ViewModel.LaunchCommand}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <interactivity:Interaction.Behaviors>
            <interactivity:EventTriggerBehavior EventName="Loaded">
                <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.LoadCommand}" />
            </interactivity:EventTriggerBehavior>
        </interactivity:Interaction.Behaviors>

        <!--  Used as a reference for Web preview popup sizing and positioning  -->
        <Rectangle x:Name="PopupDimensionsReference"
                   Grid.RowSpan="5"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Fill="Transparent"
                   SizeChanged="PopupDimensionsReference_SizeChanged"
                   StrokeThickness="0" />

        <TitleBar x:Name="AppTitleBar"
                  Title="{x:Bind ViewModel.WindowTitle}"
                  Grid.Row="0"
                  VerticalAlignment="Top">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Store/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid x:Name="TopBanner"
              Grid.Row="1"
              Margin="32,12"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}"
              ColumnSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Image Grid.RowSpan="2"
                   Height="72"
                   Source="/Assets/Img/Logo-NoBackground.svg" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Bottom"
                       Style="{StaticResource TitleLargeTextBlockStyle}"
                       Text="YUGEN APPS" />

            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       VerticalAlignment="Top"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Text="A profound awareness of the universe that triggers a deep emotional response." />
        </Grid>

        <Image Grid.RowSpan="2"
               Height="192"
               Margin="24,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Source="{ThemeResource BannerBackgroundImageSource}" />

        <Grid Grid.Row="4"
              Margin="4,0,4,4"
              Padding="16"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="{x:Bind Title}"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorTertiaryBrush}"
              CornerRadius="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <ctkc:Segmented HorizontalAlignment="Center"
                            ItemsSource="{x:Bind ViewModel.AllCategories, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}">
                <ctkc:Segmented.ItemTemplate>
                    <DataTemplate x:DataType="local:CategoryObservableObject">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ImageIcon Width="20"
                                       localXaml:ThemeAwareIcon.IconId="{x:Bind Type}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Title}" />
                        </Grid>
                    </DataTemplate>
                </ctkc:Segmented.ItemTemplate>
            </ctkc:Segmented>

            <ScrollViewer Grid.Row="1"
                          Padding="0,8">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.GroupedProjects, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical"
                                     Spacing="24" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:CategoryObservableObject">
                            <Grid HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                  RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                                           Text="{x:Bind Title, Mode=OneWay}" />

                                <ItemsRepeater Grid.Row="1"
                                               ItemsSource="{x:Bind Projects, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout ItemsJustification="Start"
                                                           ItemsStretch="Fill"
                                                           MinColumnSpacing="16"
                                                           MinItemWidth="320"
                                                           MinRowSpacing="16" />
                                    </ItemsRepeater.Layout>

                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:ProjectObservableObject">
                                            <local:ProjectTileUserControl LaunchCommand="{StaticResource MainLaunchXamlUICommand}"
                                                                          Project="{x:Bind Mode=OneWay}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Popup x:Name="WebPreviewPopup"
               Grid.RowSpan="6"
               HorizontalAlignment="Stretch"
               Closed="WebPreviewPopup_Closed"
               IsLightDismissEnabled="False"
               IsOpen="{x:Bind ViewModel.WebPreview.IsWebPreviewOpened, Mode=OneWay}"
               Opened="WebPreviewPopup_Opened">
            <Border x:Name="WebPreviewPopupContent"
                    Background="{ThemeResource ContentDialogSmokeFill}"
                    CornerRadius="8"
                    KeyDown="WebPreviewPopup_KeyDown">
                <Grid Margin="24,48,24,24"
                      Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                      CornerRadius="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,0"
                          Padding="16"
                          ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="16"
                                Height="16"
                                CornerRadius="2">
                            <Image Source="{x:Bind ViewModel.WebPreview.FaviconImage, Mode=OneWay}" />
                        </Border>

                        <Border Grid.Column="1">
                            <TextBlock VerticalAlignment="Center"
                                       MaxLines="1"
                                       Text="{x:Bind ViewModel.WebPreview.WebTitle, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </Border>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.WebPreview.LaunchExternalCommand}"
                                    ToolTipService.ToolTip="Open in external browser">
                                <ic:FluentIcon Icon="Open" />
                            </Button>
                            <AppBarSeparator />
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.WebPreview.CopyCommand}"
                                    ToolTipService.ToolTip="Copy Link">
                                <ic:FluentIcon Icon="Copy" />
                            </Button>
                            <AppBarSeparator />
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.WebPreview.CloseWebPreviewCommand}"
                                    ToolTipService.ToolTip="Close">
                                <ic:FluentIcon Icon="Dismiss" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="4"
                          CornerRadius="8">
                        <WebView2 Loaded="{x:Bind ViewModel.WebPreview.WebView2Loaded}"
                                  NavigationCompleted="{x:Bind ViewModel.WebPreview.WebView2NavigationCompleted}"
                                  NavigationStarting="{x:Bind ViewModel.WebPreview.WebView2NavigationStarting}"
                                  Source="{x:Bind ViewModel.WebPreview.WebPreviewSource, Mode=TwoWay}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.WebPreview.ErrorLoadingWebPreview, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="8">
                            <ic:FluentIcon FontSize="48"
                                           Icon="Warning"
                                           IconSize="Size48"
                                           IconVariant="Color" />
                            <TextBlock Text="Error navigating to your link."
                                       TextAlignment="Center" />
                            <Button Margin="0,24"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.WebPreview.ReloadCommand}"
                                    Content="Try again" />
                        </StackPanel>
                    </Border>

                    <ProgressBar Grid.Row="1"
                                 Margin="8,0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Top"
                                 IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.WebPreview.IsWebPreviewLoading, Mode=OneWay}" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>